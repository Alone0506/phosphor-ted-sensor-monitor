[Unit]
Description=Ted sensor monitor
Requires=phosphor-ted-sensor.service
After=phosphor-ted-sensor.service

[Service]
Restart=always
ExecStart=@bindir@/phosphor-ted-sensor-monitor
Type=dbus
BusName=xyz.openbmc_project.TedSensorMonitor
SyslogIdentifier=phosphor-ted-sensor-monitor

[Install]
WantedBy=multi-user.target
